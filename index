        function renderApp() {
            const navList = document.getElementById('navList');
            const battlesContainer = document.getElementById('battlesContainer');

            navList.innerHTML = '';
            battlesContainer.innerHTML = '';

            database.forEach((loc, index) => {
                const locId = `location-${index}`;
                
                // Sidebar item
                const totalTrainers = loc.trainers.length;
                const navItem = document.createElement('div');
                navItem.className = `nav-item ${index === 0 ? 'active' : ''}`;
                navItem.innerHTML = `
                    <span>${loc.location}</span>
                    <span class="count">${totalTrainers}</span>
                `;
                navItem.onclick = () => {
                    document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
                    navItem.classList.add('active');
                    document.getElementById(locId).scrollIntoView({ behavior: 'smooth' });
                };
                navList.appendChild(navItem);

                // Main Section
                const section = document.createElement('section');
                section.className = 'location-section';
                section.id = locId;

                let trainersHTML = '';
                loc.trainers.forEach(trainer => {
                    let pokemonHTML = '';
                    trainer.pokemon.forEach(pkmn => {
                        const spriteUrl = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${pkmn.id}.png`;
                        
                        let movesHTML = pkmn.moves.map(m => `<div class="move-tag">${m}</div>`).join('');

                        pokemonHTML += `
                            <div class="pokemon-card">
                                <div class="pkmn-top">
                                    <div class="pkmn-sprite">
                                        <img src="${spriteUrl}" alt="${pkmn.name}" loading="lazy">
                                    </div>
                                    <div class="pkmn-header-info">
                                        <div class="pkmn-name">${pkmn.name}</div>
                                        <div class="pkmn-level">Nv. ${pkmn.level}</div>
                                    </div>
                                </div>
                                <div class="pkmn-details">
                                    <div><strong>Objeto:</strong> ${pkmn.item}</div>
                                    <div><strong>Naturaleza:</strong> ${pkmn.nature}</div>
                                    <div><strong>Habilidad:</strong> ${pkmn.ability}</div>
                                    <div><strong>IVs:</strong> ${pkmn.ivs}</div>
                                    <div style="grid-column: span 2"><strong>EVs:</strong> ${pkmn.evs}</div>
                                </div>
                                <div class="moves-list">
                                    ${movesHTML}
                                </div>
                            </div>
                        `;
                    });

                    const trainerStringData = escape(JSON.stringify(trainer));

                    trainersHTML += `
                        <div class="vs-card">
                            <div class="vs-header">
                                <h3>${trainer.name}</h3>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <span class="difficulty-badge">DIFÍCIL</span>
                                    <button class="copy-btn" onclick="copyTrainerData('${trainerStringData}')">Copiar Equipo</button>
                                </div>
                            </div>
                            <div class="pokemon-grid">
                                ${pokemonHTML}
                            </div>
                        </div>
                    `;
                });

                section.innerHTML = `
                    <h2 class="location-title">${loc.location}</h2>
                    ${trainersHTML}
                `;

                battlesContainer.appendChild(section);
            });
        }

        function copyTrainerData(escapedData) {
            const trainer = JSON.parse(unescape(escapedData));
            let text = `${trainer.name} (DIFÍCIL)\n\n`;
            trainer.pokemon.forEach(p => {
                text += `- ${p.name} (Nv. ${p.level}) | Objeto: ${p.item} | Nat: ${p.nature} | Hab: ${p.ability}\n`;
                text += `  IVs: ${p.ivs} | EVs: ${p.evs}\n`;
                text += `  Movs: ${p.moves.join(', ')}\n\n`;
            });

            navigator.clipboard.writeText(text).then(() => {
                alert('¡Datos del equipo copiados al portapapeles!');
            });
        }

        function filterContent() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.pokemon-card');
            const vsCards = document.querySelectorAll('.vs-card');

            vsCards.forEach(vsCard => {
                let hasVisiblePkmn = false;
                const pkmnCards = vsCard.querySelectorAll('.pokemon-card');
                
                pkmnCards.forEach(card => {
                    const text = card.innerText.toLowerCase();
                    if (text.includes(query)) {
                        card.style.display = 'flex';
                        hasVisiblePkmn = true;
                    } else {
                        card.style.display = 'none';
                    }
                });

                const vsTitle = vsCard.querySelector('h3').innerText.toLowerCase();
                if (hasVisiblePkmn || vsTitle.includes(query)) {
                    vsCard.style.display = 'block';
                    if (vsTitle.includes(query)) {
                        pkmnCards.forEach(c => c.style.display = 'flex');
                    }
                } else {
                    vsCard.style.display = 'none';
                }
            });
        }

        // Initialize App
        renderApp();
    </script>
