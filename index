    <style>
        :root {
            --bg-dark: #0f172a;
            --bg-card: #1e293b;
            --bg-header: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-red: #ef4444;
            --accent-gold: #f59e0b;
            --border-color: #475569;
            --badge-bg: #0f172a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Navigation */
        #sidebar {
            width: 320px;
            background-color: #0b1329;
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-header {
            padding: 20px;
            background-color: #070d19;
            border-bottom: 1px solid var(--border-color);
        }

        .sidebar-header h1 {
            font-size: 1.2rem;
            color: var(--accent-red);
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-header span {
            background-color: var(--accent-red);
            color: white;
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .search-box {
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
        }

        .search-box input {
            width: 100%;
            padding: 10px;
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: white;
            outline: none;
        }

        .search-box input:focus {
            border-color: var(--accent-gold);
        }

        .nav-list {
            overflow-y: auto;
            flex-grow: 1;
            padding: 10px;
        }

        .nav-item {
            padding: 12px 15px;
            margin-bottom: 6px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.9rem;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-item:hover, .nav-item.active {
            background-color: var(--bg-card);
            color: white;
        }

        .nav-item.active {
            border-left: 4px solid var(--accent-gold);
        }

        .nav-item .count {
            background-color: var(--badge-bg);
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
        }

        /* Main Content */
        #main-content {
            margin-left: 320px;
            flex-grow: 1;
            padding: 30px;
            max-width: 1400px;
        }

        .location-section {
            margin-bottom: 50px;
        }

        .location-title {
            font-size: 1.5rem;
            color: var(--accent-gold);
            border-bottom: 2px solid var(--accent-gold);
            padding-bottom: 8px;
            margin-bottom: 25px;
            text-transform: uppercase;
        }

        .vs-card {
            background-color: var(--bg-card);
            border-radius: 10px;
            border: 1px solid var(--border-color);
            margin-bottom: 30px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        .vs-header {
            background-color: var(--bg-header);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .vs-header h3 {
            font-size: 1.2rem;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .difficulty-badge {
            background-color: var(--accent-red);
            color: white;
            padding: 4px 10px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.8rem;
            letter-spacing: 1px;
        }

        .pokemon-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 15px;
            padding: 20px;
        }

        .pokemon-card {
            background-color: var(--bg-dark);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            position: relative;
        }

        .pkmn-top {
            display: flex;
            align-items: center;
            gap: 15px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        .pkmn-sprite {
            width: 70px;
            height: 70px;
            background-color: var(--bg-card);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
        }

        .pkmn-sprite img {
            width: 60px;
            height: 60px;
            object-fit: contain;
        }

        .pkmn-header-info {
            flex-grow: 1;
        }

        .pkmn-name {
            font-size: 1.1rem;
            font-weight: bold;
            color: white;
        }

        .pkmn-level {
            font-size: 0.85rem;
            color: var(--accent-gold);
            font-weight: bold;
        }

        .pkmn-details {
            font-size: 0.85rem;
            color: var(--text-muted);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            background-color: rgba(0,0,0,0.2);
            padding: 8px;
            border-radius: 6px;
        }

        .moves-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .move-tag {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 6px 8px;
            border-radius: 4px;
            font-size: 0.78rem;
            color: #e2e8f0;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .copy-btn {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
            transition: all 0.2s;
        }

        .copy-btn:hover {
            background-color: var(--accent-gold);
            color: black;
            border-color: var(--accent-gold);
        }

        /* Responsive */
        @media (max-width: 900px) {
            body {
                flex-direction: column;
            }
            #sidebar {
                width: 100%;
                position: relative;
                height: auto;
            }
            #main-content {
                margin-left: 0;
                padding: 15px;
            }
        }
    </style>
</head>
